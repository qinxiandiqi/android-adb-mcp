{
  "name": "android-adb-mcp",
  "version": "0.0.2",
  "description": "Production-ready MCP server for Android Debug Bridge (ADB) - 35 professional tools for complete device management",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "android-adb-mcp": "dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:generate": "typedoc src --out docs --excludePrivate",
    "docs:serve": "http-server docs -p 8080",
    "benchmark": "node tests/benchmark/benchmark.js",
    "release": "node scripts/release.cjs",
    "ci": "pnpm lint && pnpm type-check && pnpm test:coverage"
  },
  "keywords": [
    "mcp",
    "adb",
    "android",
    "debug-bridge",
    "device-management",
    "automation",
    "testing",
    "model-context-protocol",
    "ai-tools",
    "mobile-development"
  ],
  "author": "Jianan",
  "homepage": "https://github.com/qinxiandiqi/android-adb-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinxiandiqi/android-adb-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/qinxiandiqi/android-adb-mcp/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "eventemitter3": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.20.6",
    "typedoc": "^0.27.0",
    "typescript": "^5.9.3"
  }
}
